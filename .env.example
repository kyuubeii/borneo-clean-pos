# Postgres. In Supabase: Connect -> ORMs -> Prisma. Use the pooled connection
# (port 6543) for the app; Prisma also wants DIRECT_URL on 5432 for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Legacy. Sessions and passwords are Supabase Auth's job now; this only still
# salts the unused User.password column, kept for rollback. Safe to drop once
# the Supabase sign-in has proven itself.
SESSION_SECRET=""

# Supabase Auth. The publishable/anon key is meant to reach the browser; the
# service role key is server-side only and must never be exposed to it.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase Storage, for job photos and expense receipts.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="uploads"

# Optional: powers the in-app assistant. Leave blank to disable it.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"
# Point at a different OpenAI-compatible gateway if you need to (defaults to OpenRouter).
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Only used by scripts/migrate-to-postgres.ts, to read the old SQLite database.
SQLITE_URL="file:./prisma/dev.db"
