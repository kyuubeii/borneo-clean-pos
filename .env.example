# Local development uses SQLite. For Supabase/Postgres use the pooled
# connection string from the Supabase dashboard (Connect -> ORMs -> Prisma).
DATABASE_URL="file:./dev.db"

# Signs session cookies and hashes passwords. MUST be set to a long random
# value in production -- the fallback in src/lib/auth.ts is a known string,
# which would let anyone forge a session cookie.
SESSION_SECRET=""

# Optional: powers the in-app assistant. Leave blank to disable it.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"
# Point at a different OpenAI-compatible gateway if you need to (defaults to OpenRouter).
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
