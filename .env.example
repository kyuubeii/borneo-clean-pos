# Postgres. In Supabase: Connect -> ORMs -> Prisma. Use the pooled connection
# (port 6543) for the app; Prisma also wants DIRECT_URL on 5432 for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Signs session cookies and hashes passwords. MUST be set to a long random
# value in production -- the fallback in src/lib/auth.ts is a known string,
# which would let anyone forge a session cookie.
#   openssl rand -base64 32
SESSION_SECRET=""

# Supabase Storage, for job photos and expense receipts. The service role key
# is server-side only and must never be exposed to the browser.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="uploads"

# Optional: powers the in-app assistant. Leave blank to disable it.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"
# Point at a different OpenAI-compatible gateway if you need to (defaults to OpenRouter).
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Only used by scripts/migrate-to-postgres.ts, to read the old SQLite database.
SQLITE_URL="file:./prisma/dev.db"
